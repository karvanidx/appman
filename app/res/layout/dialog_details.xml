<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="18dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/d_icon"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="App icon" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/d_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/d_pkg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/d_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/d_sizes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lineSpacingExtra="3dp"
            android:text="Storage: checking…"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <Button
            android:id="@+id/d_usage_access"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="4dp"
            android:background="?android:attr/selectableItemBackground"
            android:gravity="start|center_vertical"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:text="Enable usage access to see data &amp; cache sizes"
            android:textAllCaps="false"
            android:textColor="@color/primary"
            android:textSize="13sp"
            android:visibility="gone" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="6dp"
            android:background="@color/divider" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/d_open"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:minWidth="0dp"
                android:text="Open"
                android:textAllCaps="false"
                android:textColor="@color/primary" />

            <Button
                android:id="@+id/d_backup"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:minWidth="0dp"
                android:text="Backup"
                android:textAllCaps="false"
                android:textColor="@color/primary" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/d_share"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:minWidth="0dp"
                android:text="Share APK"
                android:textAllCaps="false"
                android:textColor="@color/primary" />

            <Button
                android:id="@+id/d_appinfo"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:minWidth="0dp"
                android:text="App info"
                android:textAllCaps="false"
                android:textColor="@color/primary" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/d_copy"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:minWidth="0dp"
                android:text="Copy package"
                android:textAllCaps="false"
                android:textColor="@color/primary" />

            <Button
                android:id="@+id/d_uninstall"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:minWidth="0dp"
                android:text="Uninstall"
                android:textAllCaps="false"
                android:textColor="#C62828" />
        </LinearLayout>
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="2dp"
            android:background="@color/divider" />

        <TextView
            android:id="@+id/d_shizuku_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="Shizuku: checking…"
            android:textColor="@color/primary"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/d_force_stop"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:minWidth="0dp"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:text="Force stop"
                android:textAllCaps="false"
                android:textColor="@color/primary"
                android:textSize="14sp" />

            <Button
                android:id="@+id/d_clear_cache"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:minWidth="0dp"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:text="Clear cache"
                android:textAllCaps="false"
                android:textColor="@color/primary"
                android:textSize="14sp" />

            <Button
                android:id="@+id/d_clear_data"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:minWidth="0dp"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:text="Clear data"
                android:textAllCaps="false"
                android:textColor="#C62828"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="2dp"
            android:paddingBottom="6dp"
            android:text="Power tools use Shizuku (shell access over Wireless debugging, no root)."
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

        <Button
            android:id="@+id/d_libs"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="?android:attr/selectableItemBackground"
            android:gravity="start|center_vertical"
            android:minWidth="0dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:text="Native libraries"
            android:textAllCaps="false"
            android:textColor="@color/primary"
            android:textSize="14sp" />

        <Button
            android:id="@+id/d_export"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="?android:attr/selectableItemBackground"
            android:gravity="start|center_vertical"
            android:minWidth="0dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:text="Export APKs + native libs (.zip)"
            android:textAllCaps="false"
            android:textColor="@color/primary"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
